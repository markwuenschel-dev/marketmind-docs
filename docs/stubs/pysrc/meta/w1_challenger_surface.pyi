def challenger_mean_query_scores_for_tasks(surface: W1ChallengerSurface, tasks: Sequence[MetaTask], fold_index: int) -> NDArray[np.float64]: ...
def w1_challenger_surface_summary_dict(surface: W1ChallengerSurface) -> dict[str, Any]: ...
