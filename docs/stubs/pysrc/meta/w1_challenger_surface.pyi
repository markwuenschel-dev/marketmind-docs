class W1ChallengerPrediction:
    task_id: str = ...
    fold_index: int = ...
    query_scores: tuple[float, ...] = ...
    prediction_time_utc: str = ...
    pit_boundary: str = ...
class W1ChallengerSurface:
    schema_version: str = ...
    source: str = ...
    model_family: str = ...
    predictions: tuple[W1ChallengerPrediction, ...] = ...
    task_pool_hash: str = ...
    data_fingerprint: str = ...
    splits_fingerprint: str = ...
    cost_assumptions_fingerprint: str = ...
    signal_set_version: str = ...
    created_at_utc: str = ...
    leakage_policy: str = ...
    uses_query_labels: bool = ...
    uses_xgboost_outputs: bool = ...
    uses_post_query_metrics: bool = ...
    model_state_hash: str | None = ...
    governed_checkpoint_lineage_verified: bool = ...
class W1FoldPlan:
    warmup_bars: int = ...
    fold_length_bars: int = ...
    n_walk_forward_folds: int = ...
