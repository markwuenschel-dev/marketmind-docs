from typing import Any

"""
Canonical W1 meta-allocator challenger prediction surface (governed real lane).

W1 consumes this artifact only — not trainer internals. Validation is strict and
import-light (no XGBoost / Reptile).
"""

W1_CHALLENGER_SURFACE_SCHEMA_VERSION: Any
KNOWN_LEAKAGE_POLICIES: frozenset[str] = ...
