    task_ids_by_fold: tuple[tuple[str, ...], ...] = ...
def derive_w1_fold_plan(sorted_tasks: Sequence[MetaTask], config: W1BaselineConfig) -> W1FoldPlan: ...
def valid_learned_model_state_hash(h: str | None) -> bool: ...
