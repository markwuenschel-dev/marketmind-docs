    tasks: tuple[MetaTask, ...] = ...
    task_pool_hash: str = ...
    diagnostics: dict[str, Any] = ...
    holdout_declaration: dict[str, Any] = ...
    registry: TaskRegistry = ...
    task_query_targets_net: tuple[tuple[str, float], ...] = ...
    task_support_mean_log_return_net: tuple[tuple[str, float], ...] = ...
    data_fingerprint: str | None = ...
def w1_support_mean_log_return_net_from_pool(outcome: W1RealTaskPoolOutcome) -> dict[str, float]: ...
def build_w1_real_task_pool(config: W1RealPoolConfig) -> W1RealTaskPoolOutcome: ...
